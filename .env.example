# Скопируйте файл в .env и заполните локально.
# Настоящие значения никогда не добавляйте в Git.

TELEGRAM_BOT_TOKEN=

# Идентификатор таблицы и путь к credentials сервисного аккаунта.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Будущий AI-модуль. Пока можно оставить пустым.
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

APP_ENV=development
LOG_LEVEL=INFO
